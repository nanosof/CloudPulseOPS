# CloudPulse database container environment. Copy to db.env and chmod 600.

# Superuser of the PostgreSQL instance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Application database and role created on first start
CLOUDPULSE_DB=cloudpulse
CLOUDPULSE_DB_USER=cloudpulse
CLOUDPULSE_DB_PASSWORD=change-me

TZ=Asia/Dubai

# Password of the initial "admin" web user (change it after first sign-in)
CLOUDPULSE_ADMIN_PASSWORD=change-me
