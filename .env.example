# CloudPulse application environment.
# Copy to /etc/cloudpulse/cloudpulse.env (or ~/.config/cloudpulse/cloudpulse.env for rootless Podman)
# and restrict it: chmod 600.

# Async SQLAlchemy URL of the CloudPulse database
DATABASE_URL=postgresql+asyncpg://cloudpulse:change-me@cloudpulse-db:5432/cloudpulse

# Signing key for session tokens; generate with: openssl rand -hex 32
JWT_SECRET=change-me

TZ=Asia/Dubai
